        "cap = cv2.VideoCapture(video_path)\n",
        "\n",
        "fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "\n",
        "print(\"FPS:\", fps)\n",
        "print(\"Total frames:\", frames)\n",
        "print(\"Duration:\", frames / fps, \"seconds\")\n",
        "\n",
        "cap.release()"
