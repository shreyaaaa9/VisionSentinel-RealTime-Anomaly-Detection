        "import cv2, os, time, json, statistics, re\n",
        "from PIL import Image\n",
        "import torch\n",
        "\n",
        "video_dir = '/content/dataset/test/videos'\n",
        "videos = sorted([f for f in os.listdir(video_dir) if f.endswith('.mp4')])\n",
        "\n",
        "# Map Qwen's free-text TYPE output to your official class names\n",
        "TYPE_MAP = [\n",
        "    (\"ACCIDENT\", \"traffic_accident\"),\n",
        "    (\"COLLISION\", \"traffic_accident\"),\n",
        "    (\"CONGESTION\", \"traffic_congestion\"),\n",
        "    (\"BREAKDOWN\", \"stalled_or_broken_down_vehicle\"),\n",
        "    (\"STRANDED\", \"stalled_or_broken_down_vehicle\"),\n",
        "    (\"BLOCKING\", \"vehicle_blocking_traffic\"),\n",
        "    (\"FIRE\", \"fire\"),\n",
        "    (\"SMOKE\", \"smoke\"),\n",
        "    (\"FLOOD\", \"waterlogging_or_flood\"),\n",
        "    (\"WATERLOG\", \"waterlogging_or_flood\"),\n",
        "    (\"SUSPICIOUS\", \"loitering_or_suspicious_presence\"),\n",
        "    (\"LOITER\", \"loitering_or_suspicious_presence\"),\n",
        "    (\"DEBRIS\", \"road_spill_or_debris\"),\n",
        "    (\"SPILL\", \"road_spill_or_debris\"),\n",
        "    (\"VIOLENCE\", \"fighting_or_violence\"),\n",
        "    (\"FIGHT\", \"fighting_or_violence\"),\n",
        "    (\"WRONG\", \"wrong_way_driving\"),\n",
        "]\n",
        "\n",
        "def map_class_name(qwen_output):\n",
        "    text = qwen_output.upper()\n",
        "    for keyword, class_name in TYPE_MAP:\n",
        "        if keyword in text:\n",
        "            return class_name\n",
        "    return \"traffic_accident\"  # fallback if TYPE is unclear\n",
        "\n",
        "def sample_frames_from_video(video_path, num_samples=6):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "    frames = []\n",
        "    if total_frames > 0:\n",
        "        positions = [int(i * (total_frames - 1) / (num_samples - 1)) for i in range(num_samples)]\n",
        "        for pos in positions:\n",
        "            cap.set(cv2.CAP_PROP_POS_FRAMES, pos)\n",
        "            success, frame = cap.read()\n",
        "            if success:\n",
        "                rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "                frames.append(Image.fromarray(rgb))\n",
        "    cap.release()\n",
        "    return frames\n",
        "\n",
        "STRICT_PROMPT = \"\"\"\n",
        "You are a safety-critical drone video anomaly detection system.\n",
        "\n",
        "Your job is to detect ONLY anomalies that have clear visual evidence.\n",
        "\n",
        "IMPORTANT RULES:\n",
        "- Do NOT infer an accident merely because a vehicle has headlights/lights on.\n",
        "- Do NOT infer a breakdown merely because a vehicle is visible.\n",
        "- Do NOT infer danger from a single unusual-looking object.\n",
        "- A normal vehicle driving on a highway is NORMAL.\n",
        "- Headlights, shadows, reflections, stopped-looking traffic due to perspective,\n",
        "  and normal traffic are NOT sufficient evidence of an anomaly.\n",
        "- If evidence is insufficient, choose NORMAL.\n",
        "\n",
        "Consider these anomaly types:\n",
        "1. TRAFFIC_CONGESTION\n",
        "2. VEHICLE_BREAKDOWN\n",
        "3. VEHICLE_BLOCKING_TRAFFIC\n",
        "4. ACCIDENT\n",
        "5. FIRE_SMOKE\n",
        "6. FLOOD_WATERLOGGING\n",
        "7. SUSPICIOUS_PRESENCE\n",
        "8. ROAD_DEBRIS\n",
        "9. VIOLENCE\n",
        "10. WRONG_WAY_DRIVING\n",
        "\n",
        "For an ACCIDENT, require visible evidence such as:\n",
        "- collision/crashed vehicles\n",
        "- clearly damaged vehicles\n",
        "- vehicles in an abnormal collision position\n",
        "- people/vehicles responding to a crash\n",
        "\n",
        "For VEHICLE_BREAKDOWN, require:\n",
        "- a vehicle clearly stopped in an inappropriate location\n",
        "- AND surrounding traffic/context suggests it is abnormal\n",
        "\n",
        "For TRAFFIC_CONGESTION, require:\n",
        "- many vehicles\n",
        "- slow/dense traffic\n",
        "- congestion relative to the road context\n",
        "\n",
        "For FIRE_SMOKE, require visible smoke or flames.\n",
        "\n",
        "For FLOOD_WATERLOGGING, require visible standing/flood water affecting the road.\n",
        "\n",
        "Return ONLY this format:\n",
        "\n",
        "STATUS: NORMAL or ANOMALY\n",
        "TYPE: <type or NONE>\n",
        "CONFIDENCE: <0-100>\n",
        "EVIDENCE: <specific visible evidence>\n",
        "REASON: <short explanation>\n",
        "\n",
        "If you cannot identify concrete visual evidence, return:\n",
        "\n",
        "STATUS: NORMAL\n",
        "TYPE: NONE\n",
        "CONFIDENCE: <number>\n",
        "EVIDENCE: insufficient evidence\n",
        "REASON: No clear safety-critical anomaly is visible.\n",
        "\"\"\"\n",
        "\n",
        "def run_qwen_on_frame(image):\n",
        "    messages = [\n",
        "        {\"role\": \"user\", \"content\": [\n",
        "            {\"type\": \"image\", \"image\": image},\n",
        "            {\"type\": \"text\", \"text\": STRICT_PROMPT}\n",
        "        ]}\n",
        "    ]\n",
        "    text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
        "    inputs = processor(text=[text], images=[image], padding=True, return_tensors=\"pt\").to(model.device)\n",
        "    with torch.no_grad():\n",
        "        generated_ids = model.generate(**inputs, max_new_tokens=150)\n",
        "    output = processor.batch_decode(\n",
        "        generated_ids[:, inputs[\"input_ids\"].shape[1]:],\n",
        "        skip_special_tokens=True\n",
        "    )[0]\n",
        "    return output\n",
        "\n",
        "all_predictions = []\n",
        "total_start = time.time()\n",
        "\n",
        "for vfile in videos:\n",
        "    video_id = vfile.replace('.mp4', '')\n",
        "    video_path = os.path.join(video_dir, vfile)\n",
        "    print(f\"Processing {video_id}...\")\n",
        "\n",
        "    t0 = time.time()\n",
        "    qwen_times = []\n",
        "\n",
        "    frames = sample_frames_from_video(video_path, num_samples=6)\n",
        "\n",
        "    qwen_outputs = []\n",
        "    for frame in frames:\n",
        "        qt0 = time.time()\n",
        "        output = run_qwen_on_frame(frame)\n",
        "        qwen_times.append((time.time() - qt0) * 1000)\n",
        "        qwen_outputs.append(output)\n",
        "\n",
        "    validated = [validate_qwen_result(o) for o in qwen_outputs]\n",
        "    final_decision_raw = temporal_verification(validated, min_anomalies=3)\n",
        "\n",
        "    events = []\n",
        "    if final_decision_raw == \"ANOMALY CONFIRMED\":\n",
        "        anomaly_frame_output = next((o for o, v in zip(qwen_outputs, validated) if v == \"ANOMALY\"), qwen_outputs[0])\n",
        "        class_name = map_class_name(anomaly_frame_output)\n",
        "        events = [{\n",
        "            \"class_name\": class_name,\n",
        "            \"start_time_sec\": None,\n",
        "            \"end_time_sec\": None,\n",
        "            \"explanation\": \"Evidence-gated anomaly confirmed as persisting across multiple sampled frames.\"\n",
        "        }]\n",
        "\n",
        "    end_to_end_ms = (time.time() - t0) * 1000\n",
        "\n",
        "    model_runtime = {\n",
        "        \"model_name\": \"Qwen2.5-VL-3B-Instruct\",\n",
        "        \"call_count\": len(qwen_times),\n",
        "        \"total_time_ms\": round(sum(qwen_times), 2),\n",
        "        \"average_time_ms\": round(statistics.mean(qwen_times), 2) if qwen_times else 0,\n",
        "        \"p50_time_ms\": round(statistics.median(qwen_times), 2) if qwen_times else 0,\n",
        "        \"p95_time_ms\": round(sorted(qwen_times)[int(len(qwen_times)*0.95)] if qwen_times else 0, 2),\n",
        "        \"max_time_ms\": round(max(qwen_times), 2) if qwen_times else 0\n",
        "    }\n",
        "\n",
        "    all_predictions.append({\n",
        "        \"video_id\": video_id,\n",
        "        \"events\": events,\n",
        "        \"runtime_metadata\": {\n",
        "            \"frames_processed\": len(frames),\n",
        "            \"chunks_processed\": 1,\n",
        "            \"end_to_end_internal_time_ms\": round(end_to_end_ms, 2),\n",
        "            \"model_runtimes\": [model_runtime]\n",
        "        }\n",
        "    })\n",
        "\n",
        "    print(f\"  -> {final_decision_raw} ({end_to_end_ms/1000:.1f}s)\")\n",
        "\n",
        "total_wall_time_ms = (time.time() - total_start) * 1000\n",
        "print(f\"\\nDONE. Total time: {total_wall_time_ms/1000:.1f}s across {len(videos)} videos\")"
