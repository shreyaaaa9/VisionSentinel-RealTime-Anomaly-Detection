        "import cv2\n",
        "import os\n",
        "\n",
        "video_path = \"/content/T004.mp4\"\n",
        "output_dir = \"/content/data/frames\"\n",
        "\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "cap = cv2.VideoCapture(video_path)\n",
        "\n",
        "fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "frame_number = 0\n",
        "saved = 0\n",
        "\n",
        "while True:\n",
        "    ret, frame = cap.read()\n",
        "\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # Save 1 frame every second\n",
        "    if frame_number % max(1, int(fps)) == 0:\n",
        "        filename = f\"{output_dir}/frame_{saved:04d}.jpg\"\n",
        "        cv2.imwrite(filename, frame)\n",
        "        saved += 1\n",
        "\n",
        "    frame_number += 1\n",
        "\n",
        "cap.release()\n",
        "\n",
        "print(\"✅ Frames extracted:\", saved)\n",
        "print(\"📁 Saved in:\", output_dir)"
