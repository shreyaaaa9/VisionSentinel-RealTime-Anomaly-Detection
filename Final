        "import cv2\n",
        "import os\n",
        "import pandas as pd\n",
        "\n",
        "# Define the root directory for training videos\n",
        "train_videos_root_dir = '/content/dataset/train/'\n",
        "# Define where to save extracted frames for fine-tuning\n",
        "fine_tune_frames_output_dir = '/content/fine_tune_frames'\n",
        "os.makedirs(fine_tune_frames_output_dir, exist_ok=True)\n",
        "\n",
        "training_examples = []\n",
        "fps_cache = {} # Cache FPS to avoid re-calculating for same video\n",
        "\n",
        "FINETUNE_INSTRUCTION_PROMPT = \"\"\"\n",
        "You are a safety-critical drone video anomaly detection system.\n",
        "Your job is to detect anomalies that have clear visual evidence.\n",
        "\n",
        "Analyze the provided image and determine if there is a safety-critical anomaly.\n",
        "If an anomaly is present, identify its type and provide specific visible evidence.\n",
        "If no clear anomaly is visible based on strong evidence, classify it as NORMAL.\n",
        "\n",
        "Consider these anomaly types:\n",
        "1. TRAFFIC_CONGESTION\n",
        "2. VEHICLE_BREAKDOWN\n",
        "3. VEHICLE_BLOCKING_TRAFFIC\n",
        "4. ACCIDENT\n",
        "5. FIRE_SMOKE\n",
        "6. FLOOD_WATERLOGGING\n",
        "7. SUSPICIOUS_PRESENCE\n",
        "8. ROAD_DEBRIS\n",
        "9. VIOLENCE\n",
        "10. WRONG_WAY_DRIVING\n",
        "\n",
        "Return your analysis in the following format:\n",
        "\n",
        "STATUS: NORMAL or ANOMALY\n",
        "TYPE: <type or NONE>\n",
        "CONFIDENCE: <0-100> (Estimate your confidence based on visible evidence)\n",
        "EVIDENCE: <specific visible evidence or insufficient evidence>\n",
        "REASON: <short explanation>\n",
        "\n",
        "If you cannot identify concrete visual evidence for an anomaly, always return:\n",
        "\n",
        "STATUS: NORMAL\n",
        "TYPE: NONE\n",
        "CONFIDENCE: 100\n",
        "EVIDENCE: insufficient evidence\n",
        "REASON: No clear safety-critical anomaly is visible.\n",
        "\"\"\"\n",
        "\n",
        "def extract_and_prepare_example(row):\n",
        "    video_id = row['video_id']\n",
        "    class_name = row['class_name']\n",
        "    is_anomaly_gt = row['is_anomaly']\n",
        "    start_time_sec = row['start_time_sec']\n",
        "    end_time_sec = row['end_time_sec']\n",
        "    description_summary = row['description_summary']\n",
        "    class_folder = row['class_folder']\n",
        "\n",
        "    video_path = os.path.join(train_videos_root_dir, class_folder, 'videos', f'{video_id}.mp4')\n",
        "\n",
        "    if not os.path.exists(video_path):\n",
        "        print(f\"Warning: Video not found for {video_id} at {video_path}. Skipping.\")\n",
        "        return\n",
        "\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        print(f\"Warning: Could not open video {video_id} at {video_path}. Skipping.\")\n",
        "        return\n",
        "\n",
        "    if video_id in fps_cache:\n",
        "        fps = fps_cache[video_id]\n",
        "    else:\n",
        "        fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "        if fps == 0:\n",
        "            print(f\"Warning: FPS is 0 for {video_id}. Skipping.\")\n",
        "            cap.release()\n",
        "            return\n",
        "        fps_cache[video_id] = fps\n",
        "\n",
        "    total_video_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "    if total_video_frames == 0:\n",
        "        print(f\"Warning: Video {video_id} has 0 frames. Skipping.\")\n",
        "        cap.release()\n",
        "        return\n",
        "\n",
        "    # --- Generate ANOMALY examples ---\n",
        "    if is_anomaly_gt:\n",
        "        start_frame = int(start_time_sec * fps)\n",
        "        end_frame = int(end_time_sec * fps)\n",
        "        total_frames_in_segment = max(1, end_frame - start_frame) # Ensure at least 1 frame to sample from\n",
        "\n",
        "        num_sample_frames_anomaly = 3\n",
        "        frame_indices_anomaly = []\n",
        "        if total_frames_in_segment > 0:\n",
        "            for i in range(num_sample_frames_anomaly):\n",
        "                frame_indices_anomaly.append(start_frame + int(i * total_frames_in_segment / (num_sample_frames_anomaly - 1)) if num_sample_frames_anomaly > 1 else start_frame)\n",
        "        else:\n",
        "            frame_indices_anomaly.append(start_frame)\n",
        "\n",
        "        frame_indices_anomaly = sorted(list(set([max(0, min(total_video_frames - 1, idx)) for idx in frame_indices_anomaly]))) # Ensure within video bounds\n",
        "\n",
        "        for i, frame_idx in enumerate(frame_indices_anomaly):\n",
        "            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)\n",
        "            ret, frame = cap.read()\n",
        "\n",
        "            if ret:\n",
        "                frame_filename = f\"{video_id}_anomaly_frame_{frame_idx:06d}.jpg\"\n",
        "                class_output_dir = os.path.join(fine_tune_frames_output_dir, class_folder)\n",
        "                os.makedirs(class_output_dir, exist_ok=True)\n",
        "                frame_output_path = os.path.join(class_output_dir, frame_filename)\n",
        "                cv2.imwrite(frame_output_path, frame)\n",
        "\n",
        "                expected_response = (\n",
        "                    f\"STATUS: ANOMALY\\n\"\n",
        "                    f\"TYPE: {class_name}\\n\"\n",
        "                    f\"CONFIDENCE: 100\\n\"\n",
        "                    f\"EVIDENCE: {description_summary}\\n\"\n",
        "                    f\"REASON: {description_summary}\"\n",
        "                )\n",
        "                training_examples.append({\n",
        "                    'image_path': frame_output_path,\n",
        "                    'messages': [\n",
        "                        {\"role\": \"user\", \"content\": [\n",
        "                            {\"type\": \"text\", \"text\": FINETUNE_INSTRUCTION_PROMPT}\n",
        "                        ]},\n",
        "                        {\"role\": \"assistant\", \"content\": expected_response}\n",
        "                    ]\n",
        "                })\n",
        "            else:\n",
        "                print(f\"Warning: Could not read ANOMALY frame {frame_idx} from {video_id}. Skipping.\")\n",
        "\n",
        "    # --- Generate NORMAL examples (from outside anomaly segments) ---\n",
        "    num_sample_frames_normal = 2\n",
        "    normal_frame_indices = []\n",
        "\n",
        "    # Try to get a frame before the anomaly\n",
        "    if start_frame > 0:\n",
        "        normal_frame_indices.append(max(0, start_frame - int(fps * 2))) # 2 seconds before\n",
        "    # Try to get a frame after the anomaly\n",
        "    if end_frame < total_video_frames - 1:\n",
        "        normal_frame_indices.append(min(total_video_frames - 1, end_frame + int(fps * 2))) # 2 seconds after\n",
        "\n",
        "    normal_frame_indices = sorted(list(set([max(0, min(total_video_frames - 1, idx)) for idx in normal_frame_indices]))) # Ensure within video bounds\n",
        "\n",
        "    for i, frame_idx in enumerate(normal_frame_indices):\n",
        "        # Ensure normal frames are not within the anomaly segment\n",
        "        if not (start_frame <= frame_idx <= end_frame):\n",
        "            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)\n",
        "            ret, frame = cap.read()\n",
        "\n",
        "            if ret:\n",
        "                frame_filename = f\"{video_id}_normal_frame_{frame_idx:06d}.jpg\"\n",
        "                class_output_dir = os.path.join(fine_tune_frames_output_dir, class_folder)\n",
        "                os.makedirs(class_output_dir, exist_ok=True)\n",
        "                frame_output_path = os.path.join(class_output_dir, frame_filename)\n",
        "                cv2.imwrite(frame_output_path, frame)\n",
        "\n",
        "                expected_response = (\n",
        "                    f\"STATUS: NORMAL\\n\"\n",
        "                    f\"TYPE: NONE\\n\"\n",
        "                    f\"CONFIDENCE: 100\\n\"\n",
        "                    f\"EVIDENCE: insufficient evidence\\n\"\n",
        "                    f\"REASON: No clear safety-critical anomaly is visible.\"\n",
        "                )\n",
        "                training_examples.append({\n",
        "                    'image_path': frame_output_path,\n",
        "                    'messages': [\n",
        "                        {\"role\": \"user\", \"content\": [\n",
        "                            {\"type\": \"text\", \"text\": FINETUNE_INSTRUCTION_PROMPT}\n",
        "                        ]},\n",
        "                        {\"role\": \"assistant\", \"content\": expected_response}\n",
        "                    ]\n",
        "                })\n",
        "            else:\n",
        "                print(f\"Warning: Could not read NORMAL frame {frame_idx} from {video_id}. Skipping.\")\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "print(\"Starting frame extraction and training example generation...\")\n",
        "# Apply the function to each row of the combined_ground_truth_df\n",
        "combined_ground_truth_df.apply(extract_and_prepare_example, axis=1)\n",
        "print(f\"Finished. Generated {len(training_examples)} training examples.\")\n",
        "\n",
        "# Display a few examples\n",
        "if training_examples:\n",
        "    print(\"\\nFirst 3 training examples:\")\n",
        "    for i in range(min(3, len(training_examples))):\n",
        "        example = training_examples[i]\n",
        "        print(f\"--- Example {i+1} ---\")\n",
        "        print(f\"Image Path: {example['image_path']}\")\n",
        "        print(f\"Messages: {example['messages']}\")\n",
        "else:\n",
        "    print(\"No training examples generated.\")"
